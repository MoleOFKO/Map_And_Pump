# Copy this file to .env.local and fill in your real mail account settings.
# For Gmail SMTP, use a Google app password, not your normal account password.
MAIL_PROVIDER=smtp
MAIL_FROM_NAME="Map&Pump"
MAIL_FROM_EMAIL=mapa.and.pump@email.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_NAME="Map&Pump"
SMTP_USERNAME=mapa.and.pump@email.com
SMTP_PASSWORD="your-google-app-password"
SMTP_FROM_EMAIL=mapa.and.pump@email.com
SMTP_DEBUG=0
# Use false only for local Windows/XAMPP certificate issues.
SMTP_VERIFY_PEER=true

# Optional HTTPS mail API provider. If you use this, set MAIL_PROVIDER=resend.
RESEND_API_KEY=
RESEND_FROM_NAME="Map&Pump"
RESEND_FROM_EMAIL=mapa.and.pump@email.com
# Copy this file to .env.local and fill in your real mail account settings.
# Render Free blocks SMTP ports 25, 465, and 587, so use an HTTPS mail API there.
MAIL_PROVIDER=resend
MAIL_FROM_NAME="Map & Pump"
MAIL_FROM_EMAIL=mapa.and.pump@gmail.com

# Recommended for Render Free: create a Resend API key and verify this sender/domain in Resend.
RESEND_API_KEY=re_5KKaz8To_MQCJP1TGED9nsBWECiNHR3nF
RESEND_FROM_NAME="Map & Pump"
RESEND_FROM_EMAIL=mapa.and.pump@gmail.com

# SMTP still works locally or on hosts that allow outbound SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_NAME="Map & Pump"
SMTP_USERNAME="Map & Pump"
SMTP_PASSWORD=ndvt isdc scvf ynum
SMTP_FROM_EMAIL=mapa.and.pump@gmail.com
SMTP_DEBUG=0
# Use false only for local Windows/XAMPP certificate issues.
SMTP_VERIFY_PEER=true

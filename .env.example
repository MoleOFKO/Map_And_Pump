# Copy this file to .env.local and fill in your real mail account settings.
# For Gmail SMTP, use a Google app password, not your normal account password.
# Render uses the same names as environment variables in the service settings.
DB_HOST=your-database-host
DB_PORT=4000
DB_NAME=your-database-name
DB_USERNAME=your-database-username
DB_PASSWORD=your-database-password

MAIL_PROVIDER=smtp
MAIL_FROM_NAME="Map&Pump"
MAIL_FROM_EMAIL=notifications@example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_NAME="MAP & PUMP School Project"
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM_EMAIL=notifications@example.com
SMTP_DEBUG=0
# Use false only for local Windows/XAMPP certificate issues.
SMTP_VERIFY_PEER=true

# Optional HTTPS mail API provider. If you use this, set MAIL_PROVIDER=resend.
RESEND_API_KEY=
RESEND_FROM_NAME="MAP & PUMP School Project"
RESEND_FROM_EMAIL=notifications@example.com

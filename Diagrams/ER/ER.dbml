// MAP & PUMP ER Diagram
// Derived from db.sql

Table roles {
  role_id int [pk, increment]
  role_name varchar(100) [not null]
}

Table user_license {
  license_id int [pk, increment]
  license_image varchar(255) [not null]
  face_image varchar(255)
  license_number varchar(100) [not null]
  license_name varchar(255) [not null]
  phone_number varchar(50) [not null]
  nrc_number varchar(100) [not null]
  date_of_birth date [not null]
  blood_type varchar(10) [not null]
  license_last_valid_date date [not null]
  status varchar(20) [not null, default: 'pending']
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table headquarter {
  headquarter_id int [pk, increment]
  company_name varchar(255)
  headquarters_owner_id int
  company_logo varchar(255) [unique]
  contact_number varchar(50)
  headquarter_email varchar(225) [unique, not null]
  headquarter_bio varchar(45)
  location varchar(255)
  business_license varchar(255)
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  expire_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  business_license_expire_date varchar(45)
}

Table users {
  user_id int [pk, increment]
  user_public_id varchar(16)
  user_name varchar(225) [not null]
  email varchar(255) [unique, not null]
  hashed_password varchar(255)
  license_id int
  role_id int [default: 6]
  business_role_id int
  current_role_id int [default: 6]
  status varchar(50) [not null, default: 'active']
  account_deletion_requested_at datetime
  account_deletion_scheduled_for datetime
  had_point int [not null, default: 0]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  oauth_provider varchar(50)
  oauth_provider_id varchar(255)
  oauth_avatar_url varchar(500)
  last_login_at timestamp
}

Table business_account_scope {
  business_account_id int [pk, increment]
  user_id int [not null, unique]
  business_role_id int [not null]
  headquarter_id int
  branch_manager_user_id int
  station_id int
  status varchar(50) [not null, default: 'active']
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table sessions {
  session_id int [pk, increment]
  user_id int [not null]
  ip_address varchar(45) [not null]
  user_agent varchar(255) [not null]
  is_active tinyint [not null, default: 1]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  expires_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table branches {
  branch_id int [pk, increment]
  branch_code varchar(20) [not null]
  branch_name varchar(120) [not null]
  city varchar(60) [not null]
  township varchar(60)
  address varchar(255)
  latitude decimal(10,7)
  longitude decimal(10,7)
  phone varchar(30)
  email varchar(120)
  branch_profile varchar(255)
  manager_user_id int
  opening_time time [default: '06:00:00']
  closing_time time [default: '22:00:00']
  is_24hr tinyint [default: 0]
  pump_count int [default: 4]
  tank_count int [default: 3]
  status varchar(20) [default: 'active']
  hq_region varchar(60)
  established_at date
  photo_url varchar(255)
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  updated_at datetime [default: `CURRENT_TIMESTAMP`]
}

Table staff {
  staff_id int [pk, increment]
  user_id int
  staff_code varchar(20) [not null, unique]
  branch_id int [not null]
  full_name varchar(120) [not null]
  email varchar(255)
  contact varchar(30)
  is_active tinyint [default: 1]
  hired_at date
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  updated_at datetime [default: `CURRENT_TIMESTAMP`]
}

Table accounts {
  account_id int [pk, increment]
  account_type varchar(20) [not null]
  user_id int [unique]
  staff_id int [unique]
  branch_id int [unique]
  headquarter_id int [unique]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table station_business_scope {
  station_id int [pk]
  headquarter_id int [not null]
  branch_manager_user_id int
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table oil_types {
  oil_type_id int [pk, increment]
  oil_name varchar(255) [not null]
}

Table tanks {
  tank_id int [pk, increment]
  branch_id int [not null]
  oil_type_id int
  fuel_price varchar(45) [not null, default: '0']
  capacity_l int [not null]
  current_l decimal(12,2) [not null, default: 0]
  alert_pct int [not null, default: 25]
  is_enabled tinyint [default: 1]
  updated_at datetime [default: `CURRENT_TIMESTAMP`]
}

Table station_oil_inventory {
  inventory_id int [pk, increment]
  station_id int [not null]
  oil_type_id int [not null]
  price_per_litre int [not null]
  is_active tinyint [not null]
  current_amount_liters decimal(12,3) [not null]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table car_license {
  car_license_id int [pk, increment]
  car_plate_number varchar(50) [not null]
  car_owner_name varchar(100)
  car_license_front_image varchar(255)
  car_license_back_image varchar(255)
  model_year int [not null]
  vehicle_type varchar(100) [not null]
  location varchar(255) [not null]
  filled_gas int [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table user_car {
  user_car_id int [pk, increment]
  user_id int [not null]
  car_id int [not null]
  is_active tinyint [not null, default: 0]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table booking {
  booking_id int [pk, increment]
  user_id int [not null]
  car_license_id int
  station_id int [not null]
  oil_type_id int [not null]
  requested_liters decimal(10,2) [not null, default: 0]
  qr_code varchar(255) [not null]
  qr_refrence_code varchar(255) [not null, unique]
  status varchar(50) [not null]
  filled_gas decimal(10,2) [not null, default: 0]
  points_to_redeem int [not null, default: 0]
  time_of_filled datetime
  expire_at timestamp [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table booking_partial_offers {
  booking_id int [pk]
  offered_liters decimal(10,2) [not null]
  status varchar(20) [not null, default: 'pending']
  offered_by int [not null]
  offered_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  answered_at datetime
}

Table usage_history {
  usage_id int [pk, increment]
  booking_id int [not null, unique]
  user_id int [not null]
  car_license_id int
  station_id int [not null]
  oil_type_id int [not null]
  qr_code varchar(255) [not null]
  qr_refrence_code varchar(255) [not null]
  filled_liters decimal(10,2) [not null, default: 0]
  price_per_litre decimal(12,2)
  total_cost decimal(12,2)
  status varchar(50) [not null, default: 'filled']
  booked_at timestamp
  expire_at timestamp
  filled_at datetime [not null]
  staff_user_id int
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  points_earned int [not null, default: 0]
  points_redeemed int [not null, default: 0]
  discount_mmk decimal(12,2) [not null, default: 0]
  is_internal tinyint [not null, default: 0]
  admin_share_mmk decimal(12,2)
  company_share_mmk decimal(12,2)
  company_points_earned int [not null, default: 0]
}

Table feedback {
  feedback_id int [pk, increment]
  user_id int [not null]
  feedback text [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table feedback_replies {
  reply_id int [pk, increment]
  feedback_id int [not null]
  staff_id int [not null]
  reply_text text [not null]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
}

Table system_requests {
  request_id int [pk, increment]
  reference_code varchar(40) [unique, not null]
  request_type varchar(60) [not null]
  status varchar(20) [not null, default: 'pending']
  submitter_user_id int
  role_id int
  headquarter_id int
  sender_entity varchar(255) [not null]
  sender_name varchar(255)
  sender_email varchar(255)
  location varchar(255)
  request_details text
  document_name varchar(255)
  document_path varchar(500)
  headquarter_owner_email varchar(255)
  headquarter_email varchar(255)
  headquarter_company_logo varchar(255)
  headquarter_contact_number varchar(50)
  headquarter_expire_at datetime
  review_reason text
  reviewed_by int
  reviewed_at timestamp
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table report {
  report_id int [pk, increment]
  user_id int
  submitted_by_account_id int
  role_id int [not null]
  status varchar(45)
  image int
  importance varchar(10) [not null]
  short_summery varchar(255) [not null]
  message varchar(255)
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  headquarter_id int
}

Table notifications {
  notification_id int [pk, increment]
  request_id int
  recipient_user_id int
  recipient_email varchar(255)
  notification_type varchar(40) [not null]
  subject varchar(255) [not null]
  message text [not null]
  delivery_status varchar(30) [not null, default: 'not_configured']
  delivery_note varchar(255)
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table log {
  log_id int [pk, increment]
  user_id int [not null]
  role_id int
  action varchar(255) [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

